# Demo values only. Copy to .env (make env) and change for anything real.

# TimescaleDB
POSTGRES_USER=hastori
POSTGRES_PASSWORD=hastori_demo
POSTGRES_DB=hastori
DATABASE_URL=postgresql+asyncpg://hastori:hastori_demo@127.0.0.1:5432/hastori

# MQTT (TLS only, port 8883)
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_CA_FILE=infra/mosquitto/certs/ca.crt
MQTT_INGESTION_USER=ingestion
MQTT_INGESTION_PASSWORD=ingestion_demo
MQTT_HEALTH_USER=healthcheck
MQTT_HEALTH_PASSWORD=health_demo
# Per-device passwords are derived: HMAC(MQTT_DEVICE_SECRET, device_id)
MQTT_DEVICE_SECRET=change-me-demo-device-secret

# RabbitMQ
RABBITMQ_USER=hastori
RABBITMQ_PASSWORD=hastori_demo
RABBITMQ_URL=amqp://hastori:hastori_demo@127.0.0.1:5672/

# Redis (refresh tokens, login rate limit, alarm events)
REDIS_PASSWORD=redis_demo
REDIS_URL=redis://:redis_demo@127.0.0.1:6379/0

# API: JWT_SECRET signs the access tokens (HS256, 64 hex characters when generated)
JWT_SECRET=change-me-demo-jwt-secret-0123456789abcdef
API_HTTP_PORT=8000
# Swagger UI and the OpenAPI document under /api/v1. `make env-public` switches them off.
API_DOCS=true
# Secure cookies need HTTPS; browsers exempt localhost. Set true behind the gateway (day 4).
COOKIE_SECURE=false

# Demo users (seeded, hashed with argon2)
SEED_SYSTEM_ADMIN_PASSWORD=admin_demo_pw
SEED_SITE_ADMIN_PASSWORD=siteadmin_demo_pw
SEED_VIEWER_PASSWORD=viewer_demo_pw

# Simulator
SIM_SEED=42
SIM_CONTROL_PORT=8002
# Bearer token for the simulator fault API
SIM_CONTROL_TOKEN=demo-control-token

# Ingestion
INGEST_HTTP_PORT=8001
# Alarm service
ALARM_HTTP_PORT=8003

# All services
LOG_LEVEL=INFO
